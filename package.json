{
  "name": "zundamonotify",
  "version": "0.1.0",
  "description": "AIエージェントのお仕事完了を「ずんだもん」の音声でお知らせするCLIツールなのだ",
  "type": "module",
  "bin": {
    "zundamonotify": "./bin/cli.js"
  },
  "scripts": {
    "build": "bun build ./bin/bun-entry.js --compile --target=bun-darwin-arm64 --outfile ./dist/zundamonotify-macos-arm64",
    "serve": "node bin/cli.js serve",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "license": "MIT"
}
